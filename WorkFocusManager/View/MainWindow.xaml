<Window x:Class="WorkFocusManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorkFocusManager"
        xmlns:viewmodels="clr-namespace:WorkFocusManager.ViewModels"
        xmlns:controls="clr-namespace:WorkFocusManager.Controls"
        xmlns:converters="clr-namespace:WorkFocusManager.Converters"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Width="{Binding IsShowDetailView, Converter={StaticResource DetailWidthConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Height="{Binding IsShowDetailView, Converter={StaticResource DetailHeightConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Title="WorkFocusManager"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <converters:ProgressArcConverter x:Key="ProgressArcConverter"/>
        <converters:BlackListBackgroundConverter x:Key="BlackListBackgroundConverter"/>
    </Window.Resources>
    <DockPanel>
        <StackPanel HorizontalAlignment="Center" >
            <!-- 말풍선 -->
            <Border Background="White"
                    CornerRadius="20"
                    Padding="18,8"
                    Margin="0,10,0,10"
                    Width="200"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding SystemConfig.StatusText}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- 캐릭터 이미지 -->
            <Image Width="200"
                   Height="180"
                   Stretch="Uniform"
                   MouseLeftButtonDown="CatImage_MouseLeftButtonDown"
                   gif:ImageBehavior.AnimatedSource="/Resources/CatImage.gif"/>

            <!-- 이름 -->
            <TextBlock Text="{Binding SystemConfig.Name}"
               FontWeight="Bold"
               Foreground="White"
               FontSize="18"
               HorizontalAlignment="Center"/>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- 타이머 / Start - Stop 버튼 -->
                <Grid >
                    <Button Height="50"
                            mah:VisibilityHelper.IsHidden="{Binding IsRunning}"
                            Command="{Binding ControlTimercommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Gray"
                                        CornerRadius="18"
                                        Padding="14,8"
                                        Margin="10,10,10,0">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimerText}"
                                           VerticalAlignment="Bottom"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button Height="50"
                            mah:VisibilityHelper.IsVisible="{Binding IsRunning}"
                            Command="{Binding ControlTimercommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#E8B7B2"
                                        CornerRadius="18"
                                        Padding="14,8"
                                        Margin="10,10,10,0">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDB4;"
                                           VerticalAlignment="Center"
                                           Foreground="Red"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimerText}"
                                           VerticalAlignment="Bottom"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                </Grid>

                <Button Command="{Binding ResetTimercommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Gray"
                                    CornerRadius="15"
                                    Padding="10,10"
                                    Margin="-5,0,8,-8">
                                <ContentPresenter HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Content>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Light"/>
                    </Button.Content>
                </Button>

                <Button Command="{Binding ShowDetailViewcommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Gray"
                                    CornerRadius="15"
                                    Padding="10,10"
                                    Margin="0,0,10,-8">
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Content>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Light"/>
                    </Button.Content>
                </Button>
            </StackPanel>

            <!-- 달력 -->
            <controls:Calendar DockPanel.Dock="Left" 
                               Margin="0,15,0,0"
                               mah:VisibilityHelper.IsVisible="{Binding IsShowDetailView}"
                               SelectedDate="{Binding SelectedDate}"/>
        </StackPanel>

        <Grid mah:VisibilityHelper.IsVisible="{Binding IsShowDetailView}"
              Margin="20,0,0,0">
            <TabControl Background="White"
                        TabStripPlacement="Left">
                <TabControl.Resources>

                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="Foreground" Value="White"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">

                                    <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Margin="5"
                                Padding="15,10">

                                        <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#E8B7B2"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                </TabControl.Resources>

                <TabItem Header="설정">
                    <DockPanel Background="White">
                        <Button DockPanel.Dock="Bottom" 
                                Content="설정 저장"
                                Command="{Binding SaveConfigCommand}">
                        </Button>
                        <Grid Margin="30" DockPanel.Dock="Top">
                            <Grid.Resources>
                                <Style x:Key="LabelStyle" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>

                                <Style x:Key="RoundTextBoxStyle" TargetType="TextBox">
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Background" Value="#F4F4F4"/>
                                    <Setter Property="BorderBrush" Value="#DDD"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="15">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="8,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style x:Key="RoundComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <Setter Property="Width" Value="220"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Background" Value="#F4F4F4"/>
                                    <Setter Property="BorderBrush" Value="#DDDDDD"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style x:Key="RoundComboBoxItemStyle"
                                       TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="10,4">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#E8B7B2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                            </Grid.Resources>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="현재 상태"
                                       Style="{StaticResource LabelStyle}"/>

                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding SystemConfig.StatusText}"
                                     Style="{StaticResource RoundTextBoxStyle}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="이름"
                                       Style="{StaticResource LabelStyle}"/>

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding SystemConfig.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource RoundTextBoxStyle}"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="시간 설정"
                                       Style="{StaticResource LabelStyle}"/>


                            <Viewbox Grid.Row="2"
                                     Grid.Column="1">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding Hours}"
                                              SelectedItem="{Binding SelectedHour}"
                                              Style="{StaticResource RoundComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource RoundComboBoxItemStyle}"
                                              FontSize="18"
                                              FontWeight="Bold"/>
                                    <TextBlock Text=":"
                                               Margin="5,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource LabelStyle}"/>

                                    <ComboBox ItemsSource="{Binding Minutes}"
                                              SelectedItem="{Binding SelectedMinute}"
                                              Style="{StaticResource RoundComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource RoundComboBoxItemStyle}"
                                              FontSize="18"
                                              FontWeight="Bold"/>

                                    <TextBlock Text=":"
                                               Margin="5,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource LabelStyle}"/>

                                    <ComboBox ItemsSource="{Binding Seconds}"
                                              SelectedItem="{Binding SelectedSecond}"
                                              Style="{StaticResource RoundComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource RoundComboBoxItemStyle}"
                                              FontSize="18"
                                              FontWeight="Bold"/>

                                </StackPanel>
                            </Viewbox>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="사용 기록">
                    <DockPanel Background="White">
                        <StackPanel Margin="20,20,20,10"
                                    DockPanel.Dock="Top">

                            <!-- 날짜 -->
                            <Border Background="#F5F5F5"
                                    CornerRadius="20"
                                    Padding="18,10"
                                    HorizontalAlignment="Left">

                                <StackPanel Orientation="Horizontal">

                                    <!-- 아이콘 -->
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="17"
                                            Background="#E9E1FF"
                                            Margin="0,0,12,0">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE787;"
                                                   FontSize="16"
                                                   Foreground="#7C5CFA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 날짜 텍스트 -->
                                    <StackPanel>

                                        <TextBlock Text="선택된 날짜"
                                                   FontSize="11"
                                                   Foreground="#888"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding SelectedDate, StringFormat=yyyy년 MM월 dd일}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#222"/>
                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TimerProcessingLogModels, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Height="110"
                                            Margin="15,15,15,0"
                                            Padding="18"
                                            CornerRadius="22"
                                            Background="#FAFAFA"
                                            BorderBrush="#EAEAEA"
                                            BorderThickness="1">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 왼쪽 번호 -->
                                            <Border Width="42"
                                                    Height="42"
                                                    CornerRadius="21"
                                                    Background="#EFE7FF"
                                                    VerticalAlignment="Top">

                                                <TextBlock Text="{Binding Id}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#7C5CFA"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 중앙 내용 -->
                                            <StackPanel Grid.Column="1"
                                                        Margin="15,0,0,0">

                                                <!-- 제목 -->
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#222"/>

                                                <!-- 시간 -->
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,10,0,0">

                                                    <Border Background="#F3F3F3"
                                                            CornerRadius="10"
                                                            Padding="10,4">

                                                        <StackPanel Orientation="Horizontal">

                                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                       Text="&#xE823;"
                                                                       FontSize="12"
                                                                       Margin="0,0,6,0"
                                                                       Foreground="#888"/>

                                                            <TextBlock Text="{Binding DurationTime}"
                                                                       FontSize="13"
                                                                       Foreground="#666"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 차단 프로세스 -->
                                                    <Border Background="#FFECEC"
                                                            CornerRadius="10"
                                                            Padding="10,4"
                                                            Margin="8,0,0,0">

                                                        <StackPanel Orientation="Horizontal">

                                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                       Text="&#xE72E;"
                                                                       FontSize="12"
                                                                       Margin="0,0,6,0"
                                                                       Foreground="#E45C5C"/>

                                                            <TextBlock Text="{Binding BlockProcessCount, StringFormat=차단 {0}개}"
                                                                       FontSize="13"
                                                                       Foreground="#D95353"/>
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>

                                            </StackPanel>

                                            <!-- 우측 상태 점 -->
                                            <Ellipse Grid.Column="2"
                                                     Width="10"
                                                     Height="10"
                                                     Fill="#6BE38B"
                                                     VerticalAlignment="Top"
                                                     Margin="10,6,0,0"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </TabItem>
                <TabItem Header="현재 프로세스">
                    <Grid Background="White">
                        <TreeView ItemsSource="{Binding ProcessGroupModels}"
                                  Background="Transparent"
                                  BorderThickness="0">

                            <TreeView.Resources>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu >
                                                <MenuItem Header="블랙리스트 추가" 
                                                          Command="{Binding DataContext.AddBlacklistCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}}" 
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.Resources>

                            <!-- 앱 / 백그라운드 -->
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Items}">

                                    <!-- 카테고리 -->
                                    <Border Background="#EFEFEF"
                                            Padding="8"
                                            Margin="0,5,0,5"
                                            CornerRadius="8">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="{Binding CategoryName}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="Black"/>

                                            <TextBlock Text="{Binding Count, StringFormat= ({0})}"
                                                       Margin="5,0,0,0"
                                                       Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 프로세스 그룹 -->
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                                            <Grid Height="36" 
                                                  Background="{Binding IsBlocked, Converter={StaticResource BlackListBackgroundConverter}}">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0"
                                                       Width="18"
                                                       Height="18"
                                                       Source="{Binding ProcessIcon}"
                                                       Margin="5,0"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProcessName}"
                                                           VerticalAlignment="Center"
                                                           Foreground="Black"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Count, StringFormat={}{0}개}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="Gray"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding TotalMemorySize}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="Gray"/>
                                            </Grid>

                                            <!-- 실제 프로세스 -->
                                            <HierarchicalDataTemplate.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid Height="28"
                                                          Margin="25,0,0,0"
                                                          Background="{Binding IsBlocked, Converter={StaticResource BlackListBackgroundConverter}}">

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Id}"
                                                                   Foreground="Gray"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ProcessName}"
                                                                   Foreground="Black"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding UsingMemorySize}"
                                                                   Foreground="Gray"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>

                                                </DataTemplate>
                                            </HierarchicalDataTemplate.ItemTemplate>
                                        </HierarchicalDataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </TabItem>
                <TabItem Header="차단 프로세스">
                    <Grid Background="White">
                        <TreeView ItemsSource="{Binding SystemConfig.ProcessGroupModelBlackList, UpdateSourceTrigger=PropertyChanged}"
                                  Background="Transparent"
                                  BorderThickness="0">

                            <TreeView.Resources>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="블랙리스트 삭제" 
                                          Command="{Binding DataContext.RemoveBlacklistCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:MainWindow}}"
                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.Resources>

                            <!-- 앱 / 백그라운드 -->
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                                    <Grid Height="36" 
                                          Background="{Binding IsBlocked, Converter={StaticResource BlackListBackgroundConverter}}">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                Source="{Binding ProcessIcon}"
                                                Margin="5,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProcessName}"
                                                   VerticalAlignment="Center"
                                                   Foreground="Black"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Count, StringFormat={}{0}개}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="Gray"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TotalMemorySize}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="Gray"/>
                                    </Grid>

                                    <!-- 실제 프로세스 -->
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <DataTemplate>

                                            <Grid Height="28"
                                                  Margin="25,0,0,0"
                                                  Background="{Binding IsBlocked, Converter={StaticResource BlackListBackgroundConverter}}">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Id}"
                                                           Foreground="Gray"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProcessName}"
                                                           Foreground="Black"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding UsingMemorySize}"
                                                           Foreground="Gray"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                        </DataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
