<Window x:Class="WorkFocusManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorkFocusManager"
        xmlns:viewmodels="clr-namespace:WorkFocusManager.ViewModels"
        xmlns:controls="clr-namespace:WorkFocusManager.Controls"
        xmlns:converters="clr-namespace:WorkFocusManager.Converters"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Width="{Binding IsShowDetailView, Converter={StaticResource DetailWidthConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Height="{Binding IsShowDetailView, Converter={StaticResource DetailHeightConverter}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Title="WorkFocusManager"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <converters:ProgressArcConverter x:Key="ProgressArcConverter"/>
        <converters:BlackListBackgroundConverter x:Key="BlackListBackgroundConverter"/>
    </Window.Resources>
    <DockPanel>
        <StackPanel HorizontalAlignment="Center" >
            <!-- 말풍선 -->
            <Border Background="White"
                    CornerRadius="20"
                    Padding="18,8"
                    Margin="0,10,0,10"
                    Width="200"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding SystemConfig.StatusText}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- 캐릭터 이미지 -->
            <Image Width="200"
                   Height="180"
                   Stretch="Uniform"
                   MouseLeftButtonDown="CatImage_MouseLeftButtonDown"
                   gif:ImageBehavior.AnimatedSource="/Resources/CatImage.gif"/>

            <!-- 이름 -->
            <TextBlock Text="{Binding SystemConfig.Name}"
               FontWeight="Bold"
               Foreground="White"
               FontSize="18"
               HorizontalAlignment="Center"/>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- 타이머 / Start - Stop 버튼 -->
                <Grid >
                    <Button Height="50"
                            Command="{Binding ControlTimercommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Gray"
                                        CornerRadius="18"
                                        Padding="14,8"
                                        Margin="10,10,10,0">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimerText}"
                                           VerticalAlignment="Bottom"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button Height="50"
                            mah:VisibilityHelper.IsVisible="{Binding IsRunning}"
                            Command="{Binding ControlTimercommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#E8B7B2"
                                        CornerRadius="18"
                                        Padding="14,8"
                                        Margin="10,10,10,0">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDB4;"
                                           VerticalAlignment="Center"
                                           Foreground="Red"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimerText}"
                                           VerticalAlignment="Bottom"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                </Grid>

                <Button Command="{Binding ResetTimercommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Gray"
                                    CornerRadius="15"
                                    Padding="10,10"
                                    Margin="-5,0,8,-8">
                                <ContentPresenter HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Content>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Light"/>
                    </Button.Content>
                </Button>

                <Button Command="{Binding ShowDetailViewcommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Gray"
                                    CornerRadius="15"
                                    Padding="10,10"
                                    Margin="0,0,10,-8">
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Content>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Light"/>
                    </Button.Content>
                </Button>
            </StackPanel>

            <!-- 달력 -->
            <controls:Calendar DockPanel.Dock="Left" 
                               Margin="0,15,0,0"
                               mah:VisibilityHelper.IsVisible="{Binding IsShowDetailView}"
                               SelectedDate="{Binding SelectedDate}"
                               HighlightedDurations="{Binding CalendarHighlightedDurations}"/>

            <ItemsControl ItemsSource="{Binding PendingBlockWarnings}"
                          mah:VisibilityHelper.IsVisible="{Binding IsRunning}"
                          Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF4D8"
                                CornerRadius="12"
                                Padding="10,6"
                                Margin="0,0,0,6"
                                Width="220">
                            <StackPanel>
                                <TextBlock Text="{Binding ProcessName}"
                                           FontWeight="SemiBold"
                                           Foreground="#7A4B00"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding RemainingSecondsText}"
                                           FontSize="11"
                                           Foreground="#9A6500"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid mah:VisibilityHelper.IsVisible="{Binding IsShowDetailView}"
              Margin="20,0,0,0">
            <TabControl Background="White"
                        TabStripPlacement="Left">
                <TabControl.Resources>

                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="Foreground" Value="White"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">

                                    <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Margin="5"
                                Padding="15,10">

                                        <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#E8B7B2"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                </TabControl.Resources>

                <TabItem Header="설정">
                    <Grid Background="White">
                        <Grid.Resources>
                            <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#333"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#888"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                            </Style>

                            <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="Padding" Value="14,8"/>
                                <Setter Property="Foreground" Value="#222"/>
                                <Setter Property="Background" Value="#F7F7F7"/>
                                <Setter Property="BorderBrush" Value="#E1E1E1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="12">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="6,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="SettingsComboBoxStyle"
                                   TargetType="ComboBox">
                                <Setter Property="Width" Value="96"/>
                                <Setter Property="MinHeight" Value="46"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Foreground" Value="#222"/>
                                <Setter Property="Background" Value="#F7F7F7"/>
                                <Setter Property="BorderBrush" Value="#E1E1E1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="15"/>
                            </Style>

                            <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="#222"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>

                        <Border Margin="28"
                                Padding="26"
                                Background="#FCFCFC"
                                BorderBrush="#ECECEC"
                                BorderThickness="1"
                                CornerRadius="8"
                                VerticalAlignment="Top">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Bottom"
                                        Height="42"
                                        Margin="0,24,0,0"
                                        HorizontalAlignment="Right"
                                        MinWidth="128"
                                        Command="{Binding SaveConfigCommand}"
                                        Background="#2D2D30"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE74E;"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="설정 저장"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,22">
                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="20"
                                                Background="#EFE7FF"
                                                Margin="0,0,12,0">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE713;"
                                                       FontSize="17"
                                                       Foreground="#7C5CFA"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="기본 설정"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#222"/>
                                            <TextBlock Text="상태 문구와 집중 시간을 조정합니다"
                                                       FontSize="12"
                                                       Foreground="#888"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="0,2,16,0">
                                            <TextBlock Text="현재 상태"
                                                       Style="{StaticResource SettingsLabelStyle}"/>
                                            <TextBlock Text="말풍선에 표시됩니다"
                                                       Style="{StaticResource SettingsHintStyle}"/>
                                        </StackPanel>
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Text="{Binding SystemConfig.StatusText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBoxStyle}"/>

                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="0,2,16,0">
                                            <TextBlock Text="이름"
                                                       Style="{StaticResource SettingsLabelStyle}"/>
                                            <TextBlock Text="캐릭터 아래에 표시됩니다"
                                                       Style="{StaticResource SettingsHintStyle}"/>
                                        </StackPanel>
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="1"
                                                 Text="{Binding SystemConfig.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBoxStyle}"/>

                                        <StackPanel Grid.Row="4"
                                                    Grid.Column="0"
                                                    Margin="0,2,16,0">
                                            <TextBlock Text="시간 설정"
                                                       Style="{StaticResource SettingsLabelStyle}"/>
                                            <TextBlock Text="타이머 기본값입니다"
                                                       Style="{StaticResource SettingsHintStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="4"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ComboBox ItemsSource="{Binding Hours}"
                                                          SelectedItem="{Binding SelectedHour}"
                                                          Style="{StaticResource SettingsComboBoxStyle}"
                                                          ItemContainerStyle="{StaticResource SettingsComboBoxItemStyle}"
                                                          FontSize="16"
                                                          FontWeight="SemiBold"/>
                                                <TextBlock Text="시간"
                                                           Margin="8,0,14,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#555"/>

                                                <ComboBox ItemsSource="{Binding Minutes}"
                                                          SelectedItem="{Binding SelectedMinute}"
                                                          Style="{StaticResource SettingsComboBoxStyle}"
                                                          ItemContainerStyle="{StaticResource SettingsComboBoxItemStyle}"
                                                          FontSize="16"
                                                          FontWeight="SemiBold"/>
                                                <TextBlock Text="분"
                                                           Margin="8,0,14,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#555"/>

                                                <ComboBox ItemsSource="{Binding Seconds}"
                                                          SelectedItem="{Binding SelectedSecond}"
                                                          Style="{StaticResource SettingsComboBoxStyle}"
                                                          ItemContainerStyle="{StaticResource SettingsComboBoxItemStyle}"
                                                          FontSize="16"
                                                          FontWeight="SemiBold"/>
                                                <TextBlock Text="초"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#555"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,12,0,0">
                                                <Button Content="25분"
                                                        Command="{Binding SetTimerPresetCommand}"
                                                        CommandParameter="25"
                                                        MinWidth="62"
                                                        Height="32"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="50분"
                                                        Command="{Binding SetTimerPresetCommand}"
                                                        CommandParameter="50"
                                                        MinWidth="62"
                                                        Height="32"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="90분"
                                                        Command="{Binding SetTimerPresetCommand}"
                                                        CommandParameter="90"
                                                        MinWidth="62"
                                                        Height="32"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="사용 기록">
                    <DockPanel Background="White">
                        <StackPanel Margin="20,20,20,10"
                                    DockPanel.Dock="Top">

                            <!-- 날짜 -->
                            <Border Background="#F5F5F5"
                                    CornerRadius="20"
                                    Padding="18,10"
                                    HorizontalAlignment="Left">

                                <StackPanel Orientation="Horizontal">

                                    <!-- 아이콘 -->
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="17"
                                            Background="#E9E1FF"
                                            Margin="0,0,12,0">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE787;"
                                                   FontSize="16"
                                                   Foreground="#7C5CFA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 날짜 텍스트 -->
                                    <StackPanel>

                                        <TextBlock Text="선택된 날짜"
                                                   FontSize="11"
                                                   Foreground="#888"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding SelectedDate, StringFormat=yyyy년 MM월 dd일}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#222"/>
                                    </StackPanel>

                                </StackPanel>

                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,14,0,0">
                                <Border Background="#EEF8F1"
                                        CornerRadius="12"
                                        Padding="14,8"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="오늘 집중"
                                                   FontSize="11"
                                                   Foreground="#587A61"/>
                                        <TextBlock Text="{Binding TodayUsageStatistics.TotalDurationText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#274A31"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#EEF8F1"
                                        CornerRadius="12"
                                        Padding="14,8"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="오늘 세션"
                                                   FontSize="11"
                                                   Foreground="#587A61"/>
                                        <TextBlock Text="{Binding TodayUsageStatistics.SessionCount, StringFormat={}{0}회}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#274A31"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F3F3F3"
                                        CornerRadius="12"
                                        Padding="14,8"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="월 집중 시간"
                                                   FontSize="11"
                                                   Foreground="#777"/>
                                        <TextBlock Text="{Binding MonthlyUsageStatistics.TotalDurationText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#222"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F3F3F3"
                                        CornerRadius="12"
                                        Padding="14,8"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="월 세션"
                                                   FontSize="11"
                                                   Foreground="#777"/>
                                        <TextBlock Text="{Binding MonthlyUsageStatistics.SessionCount, StringFormat={}{0}회}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#222"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFECEC"
                                        CornerRadius="12"
                                        Padding="14,8">
                                    <StackPanel>
                                        <TextBlock Text="월 차단"
                                                   FontSize="11"
                                                   Foreground="#B44"/>
                                        <TextBlock Text="{Binding MonthlyUsageStatistics.BlockProcessCount, StringFormat={}{0}개}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D95353"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <Border Background="#F6F6F6"
                                        CornerRadius="12"
                                        Padding="14,8"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="오늘 최장 세션"
                                                   FontSize="11"
                                                   Foreground="#777"/>
                                        <TextBlock Text="{Binding TodayUsageStatistics.LongestDurationText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#222"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFECEC"
                                        CornerRadius="12"
                                        Padding="14,8">
                                    <StackPanel>
                                        <TextBlock Text="오늘 차단"
                                                   FontSize="11"
                                                   Foreground="#B44"/>
                                        <TextBlock Text="{Binding TodayUsageStatistics.BlockProcessCount, StringFormat={}{0}개}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D95353"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TimerProcessingLogModelColleciton}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Height="110"
                                            Margin="15,15,15,0"
                                            Padding="18"
                                            CornerRadius="22"
                                            Background="#FAFAFA"
                                            BorderBrush="#EAEAEA"
                                            BorderThickness="1">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 왼쪽 번호 -->
                                            <Border Width="42"
                                                    Height="42"
                                                    CornerRadius="21"
                                                    Background="#EFE7FF"
                                                    VerticalAlignment="Top">

                                                <TextBlock Text="{Binding Id}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#7C5CFA"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 중앙 내용 -->
                                                <StackPanel Grid.Column="1"
                                                            Margin="15,0,0,0">

                                                <!-- 제목 -->
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#222"/>

                                                <!-- 시간 -->
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,10,0,0">

                                                    <Border Background="#F3F3F3"
                                                            CornerRadius="10"
                                                            Padding="10,4">

                                                        <StackPanel Orientation="Horizontal">

                                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                       Text="&#xE823;"
                                                                       FontSize="12"
                                                                       Margin="0,0,6,0"
                                                                       Foreground="#888"/>

                                                            <TextBlock Text="{Binding DurationTime}"
                                                                       FontSize="13"
                                                                       Foreground="#666"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 차단 프로세스 -->
                                                    <Border Background="#FFECEC"
                                                            CornerRadius="10"
                                                            Padding="10,4"
                                                            Margin="8,0,0,0">

                                                        <StackPanel Orientation="Horizontal">

                                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                       Text="&#xE72E;"
                                                                       FontSize="12"
                                                                       Margin="0,0,6,0"
                                                                       Foreground="#E45C5C"/>

                                                            <TextBlock Text="{Binding BlockProcessCount, StringFormat=차단 {0}개}"
                                                                       FontSize="13"
                                                                       Foreground="#D95353"/>
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>

                                                </StackPanel>

                                                <ItemsControl Grid.Column="1"
                                                              Margin="15,56,0,0"
                                                              ItemsSource="{Binding BlockedProcesses}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#FFF4F4"
                                                                    CornerRadius="9"
                                                                    Padding="8,3"
                                                                    Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding ProcessName}"
                                                                           FontSize="11"
                                                                           Foreground="#C44747"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- 우측 상태 점 -->
                                                <Ellipse Grid.Column="2"
                                                     Width="10"
                                                     Height="10"
                                                     Fill="#6BE38B"
                                                     VerticalAlignment="Top"
                                                     Margin="10,6,0,0"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </TabItem>
                <TabItem Header="현재 프로세스">
                    <DockPanel Background="White" LastChildFill="True">
                        <Border DockPanel.Dock="Top" Background="#F7F7F7" Padding="18,14" BorderBrush="#ECECEC" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="현재 프로세스" FontSize="20" FontWeight="Bold" Foreground="#222"/>
                                    <TextBlock Text="우클릭으로 차단하거나 예외로 지정할 수 있습니다" FontSize="12" Foreground="#888" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="개수" FontWeight="SemiBold" Foreground="#777" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="메모리" FontWeight="SemiBold" Foreground="#777" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <TreeView ItemsSource="{Binding ProcessGroupModels}" Background="Transparent" BorderThickness="0" Padding="14" HorizontalContentAlignment="Stretch">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                                    <Border Background="#2D2D30" Padding="12,8" Margin="0,8,0,6" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                            <TextBlock Text="{Binding Count, StringFormat= ({0})}" Margin="5,0,0,0" Foreground="#D8D8D8"/>
                                        </StackPanel>
                                    </Border>

                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                                            <Border Margin="0,3,0,3" Padding="10" CornerRadius="7" Background="{Binding IsBlocked, Converter={StaticResource BlackListBackgroundConverter}}" BorderBrush="#E8E8E8" BorderThickness="1" HorizontalAlignment="Stretch" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="블랙리스트 추가" Command="{Binding PlacementTarget.Tag.AddBlacklistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Width="20" Height="20" Source="{Binding ProcessIcon}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="#222"/>
                                                        <TextBlock Text="프로세스 그룹" FontSize="10" Foreground="#888"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#F0F0F0" CornerRadius="10" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Count, StringFormat={}{0}개}" FontSize="12" Foreground="#555"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding TotalMemorySize}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#666"/>
                                                </Grid>
                                            </Border>

                                            <HierarchicalDataTemplate.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="28,2,0,2" Padding="9,6" CornerRadius="6" Background="{Binding IsBlocked, Converter={StaticResource BlackListBackgroundConverter}}" BorderBrush="#EFEFEF" BorderThickness="1" HorizontalAlignment="Stretch" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="블랙리스트 추가" Command="{Binding PlacementTarget.Tag.AddBlacklistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                <MenuItem Header="예외 추가" Command="{Binding PlacementTarget.Tag.AddWhiteListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                <MenuItem Header="예외 삭제" Command="{Binding PlacementTarget.Tag.RemoveWhiteListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Id}" Foreground="#999" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ProcessName}" Foreground="#333" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding UsingMemorySize}" Foreground="#777" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </HierarchicalDataTemplate.ItemTemplate>
                                        </HierarchicalDataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>
                <TabItem Header="차단 프로세스">
                    <DockPanel Background="White" LastChildFill="True">
                        <Border DockPanel.Dock="Top" Background="#FFF7F7" Padding="18,14" BorderBrush="#F1D8D8" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="차단 프로세스" FontSize="20" FontWeight="Bold" Foreground="#222"/>
                                    <TextBlock Text="표시 이름과 메모를 바로 편집할 수 있습니다" FontSize="12" Foreground="#888" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="메모" FontWeight="SemiBold" Foreground="#AA6666" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Column="2" Text="개수" FontWeight="SemiBold" Foreground="#AA6666" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="메모리" FontWeight="SemiBold" Foreground="#AA6666" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <TreeView ItemsSource="{Binding SystemConfig.ProcessGroupModelBlackList}" Background="Transparent" BorderThickness="0" Padding="14" HorizontalContentAlignment="Stretch">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                                    <Border Margin="0,4,0,6" Padding="10" CornerRadius="7" Background="#FFF9F9" BorderBrush="#F1D8D8" BorderThickness="1" HorizontalAlignment="Stretch" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="블랙리스트 삭제" Command="{Binding PlacementTarget.Tag.RemoveBlacklistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="예외 추가" Command="{Binding PlacementTarget.Tag.AddWhiteListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="예외 삭제" Command="{Binding PlacementTarget.Tag.RemoveWhiteListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Width="20" Height="20" Source="{Binding ProcessIcon}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="24" Padding="4,0" BorderThickness="0" Background="Transparent" Foreground="#222" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ProcessName}" FontSize="10" Foreground="#888"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="2" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="8,2" BorderBrush="#E8CACA" Background="White" Foreground="#333" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Count, StringFormat={}{0}개}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#777"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TotalMemorySize}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#777"/>
                                        </Grid>
                                    </Border>

                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="28,2,0,2" Padding="9,6" CornerRadius="6" Background="#FFFCFC" BorderBrush="#F1E0E0" BorderThickness="1" HorizontalAlignment="Stretch" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="블랙리스트 삭제" Command="{Binding PlacementTarget.Tag.RemoveBlacklistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="예외 추가" Command="{Binding PlacementTarget.Tag.AddWhiteListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="예외 삭제" Command="{Binding PlacementTarget.Tag.RemoveWhiteListCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Id}" Foreground="#999" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProcessName}" Foreground="#333" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UsingMemorySize}" Foreground="#777" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
